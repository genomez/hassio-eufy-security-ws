index 0000000..d008cd3
--- /dev/null
+++ b/src/lib/driver/mega_login.ts
@@ -0,0 +1,108 @@
+import { EufySecurity } from "eufy-security-client";
+import { ILogObj, Logger } from "tslog";
+
+import { ClientsController } from "../server.js";
+import { DriverEvent } from "./event.js";
+import { DriverMessageHandler } from "./message_handler.js";
+
+let megaLoginInFlight = false;
+
+function notifyVerifyCode(clientsController: ClientsController): void {
+  clientsController.clients.forEach((client) =>
+    client.sendEvent({
+      source: "driver",
+      event: DriverEvent.verifyCode,
+    }),
+  );
+}
+
+function handleMegaLoginResult(
+  result: Awaited<ReturnType<EufySecurity["loginMega"]>>,
+  clientsController: ClientsController,
+  logger: Logger<ILogObj>,
+): void {
+  switch (result) {
+    case "ok":
+      logger.info("v6 mega login: session ready");
+      break;
+    case "tfa_required":
+      DriverMessageHandler.megaTfa = true;
+      DriverMessageHandler.tfa = true;
+      notifyVerifyCode(clientsController);
+      logger.info("v6 mega login: email verification code required");
+      break;
+    case "captcha_required":
+      DriverMessageHandler.megaCaptcha = true;
+      logger.info("v6 mega login: captcha required");
+      break;
+    case "locked":
+      logger.warn("v6 mega login: account temporarily locked ΓÇö stop retrying");
+      break;
+    case "failed":
+      logger.warn("v6 mega login failed (legacy push unchanged)");
+      break;
+  }
+}
+
+export async function ensureMegaLogin(
+  driver: EufySecurity,
+  clientsController: ClientsController,
+  logger: Logger<ILogObj>,
+): Promise<void> {
+  if (megaLoginInFlight) {
+    logger.info("v6 mega login: bootstrap already in progress");
+    return;
+  }
+  megaLoginInFlight = true;
+  logger.info("v6 mega login: bootstrap triggered by driver connect");
+  try {
+    handleMegaLoginResult(
+      await driver.loginMega(),
+      clientsController,
+      logger,
+    );
+  } catch {
+    logger.warn("v6 mega login error (details logged by client stage diagnostics)");
+  } finally {
+    megaLoginInFlight = false;
+  }
+}
+
+export async function completeMegaVerifyCode(
+  driver: EufySecurity,
+  verifyCode: string,
+  clientsController: ClientsController,
+  logger: Logger<ILogObj>,
+): Promise<boolean> {
+  try {
+    const result = await driver.loginMega(verifyCode);
+    DriverMessageHandler.megaTfa = false;
+    DriverMessageHandler.tfa = false;
+    handleMegaLoginResult(result, clientsController, logger);
+    return result === "ok";
+  } catch {
+    logger.warn("v6 mega login verification failed");
+    return false;
+  }
+}
+
+export async function completeMegaCaptcha(
+  driver: EufySecurity,
+  captchaId: string,
+  captcha: string,
+  clientsController: ClientsController,
+  logger: Logger<ILogObj>,
+): Promise<boolean> {
+  try {
+    const result = await driver.loginMega(undefined, {
+      captchaId,
+      answer: captcha,
+    });
+    DriverMessageHandler.megaCaptcha = false;
+    handleMegaLoginResult(result, clientsController, logger);
+    return result === "ok";
+  } catch {
+    logger.warn("v6 mega captcha login failed");
+    return false;
+  }
+}
